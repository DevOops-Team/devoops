# ------------------------------------------------------------------
# 비밀정보 — 공개 레포이므로 절대 커밋 금지
# ------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*token*.txt
*credentials*.txt
*credentials*.json
*credentials*.csv
kubeconfig
*.kubeconfig
admin.conf
clouds.yaml
clouds-public.yaml
secure.yaml
passwords.yml
admin-openrc.sh
*-openrc.sh
secrets.yaml
*.secret.yaml

# ------------------------------------------------------------------
# Terraform — state/plan/변수 파일에 비밀번호·토큰이 평문으로 남는다
# ------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ------------------------------------------------------------------
# Packer / Ansible / 이미지
# ------------------------------------------------------------------
packer_cache/
output-*/
*.qcow2
*.img
*.iso
*.retry
.vault_pass*

# ------------------------------------------------------------------
# Python
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ------------------------------------------------------------------
# Node (포털 FE를 Node 기반으로 정할 경우)
# ------------------------------------------------------------------
node_modules/
.next/
.nuxt/
.cache/
npm-debug.log*
yarn-error.log*

# ------------------------------------------------------------------
# 빌드 산출물 / 아카이브
# ------------------------------------------------------------------
*.tar
*.tar.gz
*.tgz
*.zip
*.log

# ------------------------------------------------------------------
# IDE / OS
# ------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
